PRODUCTION_PLAN_DB_PATH=backend/data/production_plan.db
PRODUCTION_PLAN_BACKUP_DIR=backend/data/backups
PRODUCTION_PLAN_WORKER_POLL_SECONDS=1
PRODUCTION_PLAN_ERP_BASE_URL=http://127.0.0.1:5931
PRODUCTION_PLAN_ERP_TIMEOUT_SECONDS=60
PRODUCTION_PLAN_ERP_AUTHORIZATION=Bearer mvp-dev-token
PRODUCTION_PLAN_ERP_ORDERS_SOURCE=HTTP_LIST
PRODUCTION_PLAN_ERP_ORDERS_METHOD=GET
PRODUCTION_PLAN_ERP_ORDERS_PATH=/v1/erp/production-orders
PRODUCTION_PLAN_ERP_ORDER_MATERIALS_SOURCE=HTTP
PRODUCTION_PLAN_ERP_BOM_CHILDREN_SOURCE=HTTP
PRODUCTION_PLAN_ERP_INVENTORY_SOURCE=HTTP
PRODUCTION_PLAN_ERP_SUPPLY_SOURCE=HTTP
PRODUCTION_PLAN_ERP_K3CLOUD_BASE_URL=
PRODUCTION_PLAN_ERP_K3CLOUD_ACCT_ID=
PRODUCTION_PLAN_ERP_K3CLOUD_USERNAME=
PRODUCTION_PLAN_ERP_K3CLOUD_PASSWORD=
PRODUCTION_PLAN_ERP_K3CLOUD_LCID=2052
PRODUCTION_PLAN_ERP_K3CLOUD_VERIFY_SSL=false
PRODUCTION_PLAN_ERP_K3CLOUD_ORDERS_FORM_ID=PRD_MO
PRODUCTION_PLAN_ERP_K3CLOUD_ORDERS_FIELD_KEYS=FID,FBillNo,FDocumentStatus,FMaterialId.FNumber,FMaterialId.FName,FMaterialId.FSpecification,FQty,FPlanStartDate,FPlanFinishDate,FSrcBillNo
PRODUCTION_PLAN_ERP_K3CLOUD_ORDERS_ORDER_STRING=FID DESC
PRODUCTION_PLAN_ERP_K3CLOUD_ORDERS_LIMIT=200
PRODUCTION_PLAN_ERP_K3CLOUD_ORDERS_MATERIAL_FIELD=FMaterialId.FNumber
PRODUCTION_PLAN_ERP_K3CLOUD_ORDERS_BILL_NO_FIELD=FBillNo
PRODUCTION_PLAN_ERP_K3CLOUD_ORDERS_NAME_FIELD=FMaterialId.FName
PRODUCTION_PLAN_ERP_K3CLOUD_ORDERS_SPEC_FIELD=FMaterialId.FSpecification
PRODUCTION_PLAN_ERP_K3CLOUD_ORDERS_QTY_FIELD=FQty
PRODUCTION_PLAN_ERP_K3CLOUD_ORDERS_STATUS_FIELD=FDocumentStatus
PRODUCTION_PLAN_ERP_K3CLOUD_ORDERS_START_DATE_FIELD=FPlanStartDate
PRODUCTION_PLAN_ERP_K3CLOUD_ORDERS_END_DATE_FIELD=FPlanFinishDate
PRODUCTION_PLAN_ERP_K3CLOUD_ORDERS_SOURCE_BILL_FIELD=FSrcBillNo
PRODUCTION_PLAN_ERP_K3CLOUD_ORDERS_MATERIAL_LIST_FIELD=
PRODUCTION_PLAN_ERP_ORDER_MATERIALS_METHOD=GET
PRODUCTION_PLAN_ERP_ORDER_MATERIALS_PATH=/api/test/erp/material-issues/{production_order_no}?mode=real
PRODUCTION_PLAN_ERP_BOM_CHILDREN_METHOD=GET
PRODUCTION_PLAN_ERP_BOM_CHILDREN_PATH=/internal/v1/internal/order-pool/materials/{parent_material_code}/children?refresh=true
PRODUCTION_PLAN_ERP_INVENTORY_METHOD=GET
PRODUCTION_PLAN_ERP_INVENTORY_PATH=/api/test/erp/material-inventory/{material_code}
PRODUCTION_PLAN_ERP_SUPPLY_METHOD=GET
PRODUCTION_PLAN_ERP_SUPPLY_PATH=/api/test/erp/material-supply/{material_code}
PRODUCTION_PLAN_MASTERDATA_PROCESS_ROUTES_METHOD=GET
PRODUCTION_PLAN_MASTERDATA_PROCESS_ROUTES_PATH=/v1/mes/process-routes
PRODUCTION_PLAN_MASTERDATA_EQUIPMENT_CAPABILITIES_METHOD=GET
PRODUCTION_PLAN_MASTERDATA_EQUIPMENT_CAPABILITIES_PATH=/v1/mes/equipment-process-capabilities
